# Server
PDF_MCP_TRANSPORT=stdio
PDF_MCP_HOST=127.0.0.1
PDF_MCP_PORT=3333
PDF_MCP_HTTP_PATH=/mcp
# Required for non-loopback HTTP deployments. Use a long random token.
PDF_MCP_AUTH_TOKEN=
PDF_MCP_ALLOWED_ORIGINS=http://localhost:3000
# Add the reverse-proxy hostname when using HTTP behind Nginx/Traefik.
PDF_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,mcp-pdf

# Filesystem sandbox.
# - By default, the entire client workspace (via MCP roots or cwd) is writable,
#   and generated PDFs without `outputDir` land in <workspace>/output.
# - PDF_MCP_OUTPUT_DIR: relative -> <workspace>/<dir>; absolute -> fixed default output folder.
# - PDF_MCP_ALLOWED_DIRS: extra folders where agents may read/write PDFs (separated by ; or :).
# - PDF_MCP_ALLOW_ANY_PATH: set to true in trusted local environments to allow any absolute path.
# - ASSET_DIR/FONT_DIR: relative -> resolved against the server installation.
PDF_MCP_OUTPUT_DIR=./output
PDF_MCP_ALLOWED_DIRS=
PDF_MCP_ALLOW_ANY_PATH=false
PDF_MCP_ASSET_DIR=./assets
PDF_MCP_MAX_OUTPUT_BYTES=52428800
PDF_MCP_MAX_INPUT_BYTES=52428800

# Remote images are fetched only when explicitly enabled; HTTPS only, private IPs denied.
PDF_MCP_ALLOW_REMOTE_IMAGES=false
PDF_MCP_IMAGE_TIMEOUT_MS=5000
PDF_MCP_IMAGE_MAX_BYTES=8388608

# Optional system utility required only for PDF encryption/permission flags.
# Auto-discovered across Windows (Program Files/Scoop/Choco), macOS (Homebrew/MacPorts) and Linux (/usr/bin).
QPDF_PATH=qpdf
PDF_MCP_QPDF_TIMEOUT_MS=30000

# Optional locally supplied fonts. No font binaries are redistributed with this project.
PDF_MCP_FONT_DIR=./assets/fonts
PDF_MCP_MAX_CONCURRENT_RENDERS=2
