{
  "name": "mcp-pdf-server",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise MCP server for deterministic, component-based PDF generation and post-processing.",
  "type": "module",
  "bin": {
    "mcp-pdf-server": "dist/index.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "PDF_MCP_TRANSPORT=http node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node tests/e2e-smoke.mjs && node tests/cwd-smoke.mjs && node tests/http-smoke.mjs",
    "smoke:stdio": "node tests/e2e-smoke.mjs",
    "smoke:cwd": "node tests/cwd-smoke.mjs",
    "smoke:http": "node tests/http-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@react-pdf/renderer": "4.9.0",
    "dotenv": "18.0.10",
    "lowlight": "3.3.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "pdfjs-dist": "^6.5.438",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
